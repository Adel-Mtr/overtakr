# Comma-separated frontend origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional single frontend URL; appended to CORS_ALLOW_ORIGINS when set.
FRONTEND_URL=

# Optional FastF1 runtime cache location. Relative paths are resolved from backend/.
FASTF1_CACHE_DIR=ff1cache
